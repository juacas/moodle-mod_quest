{{!
    @template mod_quest/leaderboard

    Leaderboard rankings template with podium and table.
}}
<div class="mod-quest-leaderboard mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="fa fa-trophy text-warning me-2" aria-hidden="true"></i>
                {{#isteams}}{{#str}}teams, quest{{/str}}{{/isteams}}
                {{^isteams}}{{#str}}globalranking, quest{{/str}}{{/isteams}}
            </h3>
            <!-- <span class="text-muted">{{questname}}</span> -->
        </div>
        <div class="d-flex gap-2">
            {{#isteams}}
            {{#showclasifindividual}}
            <a href="{{{globalurl}}}" class="btn btn-outline-primary btn-sm">
                <i class="fa fa-user me-1" aria-hidden="true"></i> {{#str}}viewclasificationglobal, quest{{/str}}
            </a>
            {{/showclasifindividual}}
            {{/isteams}}
            {{^isteams}}
            {{#allowteams}}
            <a href="{{{teamsurl}}}" class="btn btn-outline-primary btn-sm">
                <i class="fa fa-users me-1" aria-hidden="true"></i> {{#str}}viewclasificationteams, quest{{/str}}
            </a>
            {{/allowteams}}
            {{/isteams}}
            <a href="{{{backurl}}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1" aria-hidden="true"></i> {{#str}}back, quest{{/str}}
            </a>
        </div>
    </div>

    {{#isteams}}
    <!-- Team Standings Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;" class="text-center">
                                <a href="{{{sort_rank.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}rank, quest{{/str}}{{{sort_rank.icon}}}</a>{{{help_rank}}}
                            </th>
                            <th scope="col">
                                <a href="{{{sort_team.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}team, quest{{/str}}{{{sort_team.icon}}}</a>{{{help_team}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_nanswers.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}nanswers, quest{{/str}}{{{sort_nanswers.icon}}}</a>{{{help_nanswers}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_nanswersassessment.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}nanswersassessment, quest{{/str}}{{{sort_nanswersassessment.icon}}}</a>{{{help_nanswersassessment}}}
                            </th>
                            {{#showauthoringdetails}}
                            <th scope="col" class="text-center">
                                <a href="{{{sort_nsubmissions.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}nsubmissions, quest{{/str}}{{{sort_nsubmissions.icon}}}</a>{{{help_nsubmissions}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_nsubmissionsassessment.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}nsubmissionsassessment, quest{{/str}}{{{sort_nsubmissionsassessment.icon}}}</a>{{{help_nsubmissionsassessment}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_pointssubmission.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}pointssubmission, quest{{/str}}{{{sort_pointssubmission.icon}}}</a>{{{help_pointssubmission}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_pointsanswers.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}pointsanswers, quest{{/str}}{{{sort_pointsanswers.icon}}}</a>{{{help_pointsanswers}}}
                            </th>
                            {{/showauthoringdetails}}
                            <th scope="col" class="text-end pe-4">
                                <a href="{{{sort_points.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}totalpoints, quest{{/str}}{{{sort_points.icon}}}</a>{{{help_points}}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#standings}}
                        <tr>
                            <td class="text-center">
                                {{#istop1}}
                                <svg class="quest-medal quest-medal-gold" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="1º">
                                    <title>1º</title>
                                    <path d="M12 2L7 16L13 17L18 2H12Z" fill="#DC2626"/>
                                    <path d="M12 2L8.5 10.5L13 17L18 2H12Z" fill="#991B1B"/>
                                    <path d="M24 2L29 16L23 17L18 2H24Z" fill="#2563EB"/>
                                    <path d="M24 2L27.5 10.5L23 17L18 2H24Z" fill="#1D4ED8"/>
                                    <path d="M15 14L18 18L21 14H15Z" fill="#7F1D1D"/>
                                    <circle cx="18" cy="22" r="11" fill="#D97706"/>
                                    <circle cx="18" cy="22" r="9.5" fill="url(#questGoldGrad)"/>
                                    <circle cx="18" cy="22" r="7.8" stroke="#F59E0B" stroke-width="0.8" fill="none"/>
                                    <path d="M18 17.5L19.3 20.7L22.6 20.9L20 22.9L20.9 26.2L18 24.3L15.1 26.2L16 22.9L13.4 20.9L16.7 20.7L18 17.5Z" fill="#FFFBEB" stroke="#B45309" stroke-width="0.5"/>
                                    <defs>
                                        <linearGradient id="questGoldGrad" x1="12" y1="13" x2="24" y2="31" gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#FDE047"/>
                                            <stop offset="0.45" stop-color="#F59E0B"/>
                                            <stop offset="1" stop-color="#D97706"/>
                                        </linearGradient>
                                    </defs>
                                </svg>
                                {{/istop1}}
                                {{#istop2}}
                                <svg class="quest-medal quest-medal-silver" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="2º">
                                    <title>2º</title>
                                    <path d="M12 2L7 16L13 17L18 2H12Z" fill="#DC2626"/>
                                    <path d="M12 2L8.5 10.5L13 17L18 2H12Z" fill="#991B1B"/>
                                    <path d="M24 2L29 16L23 17L18 2H24Z" fill="#2563EB"/>
                                    <path d="M24 2L27.5 10.5L23 17L18 2H24Z" fill="#1D4ED8"/>
                                    <path d="M15 14L18 18L21 14H15Z" fill="#7F1D1D"/>
                                    <circle cx="18" cy="22" r="11" fill="#64748B"/>
                                    <circle cx="18" cy="22" r="9.5" fill="url(#questSilverGrad)"/>
                                    <circle cx="18" cy="22" r="7.8" stroke="#94A3B8" stroke-width="0.8" fill="none"/>
                                    <path d="M18 17.5L19.3 20.7L22.6 20.9L20 22.9L20.9 26.2L18 24.3L15.1 26.2L16 22.9L13.4 20.9L16.7 20.7L18 17.5Z" fill="#FFFFFF" stroke="#475569" stroke-width="0.5"/>
                                    <defs>
                                        <linearGradient id="questSilverGrad" x1="12" y1="13" x2="24" y2="31" gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#FFFFFF"/>
                                            <stop offset="0.45" stop-color="#CBD5E1"/>
                                            <stop offset="1" stop-color="#94A3B8"/>
                                        </linearGradient>
                                    </defs>
                                </svg>
                                {{/istop2}}
                                {{#istop3}}
                                <svg class="quest-medal quest-medal-bronze" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="3º">
                                    <title>3º</title>
                                    <path d="M12 2L7 16L13 17L18 2H12Z" fill="#DC2626"/>
                                    <path d="M12 2L8.5 10.5L13 17L18 2H12Z" fill="#991B1B"/>
                                    <path d="M24 2L29 16L23 17L18 2H24Z" fill="#2563EB"/>
                                    <path d="M24 2L27.5 10.5L23 17L18 2H24Z" fill="#1D4ED8"/>
                                    <path d="M15 14L18 18L21 14H15Z" fill="#7F1D1D"/>
                                    <circle cx="18" cy="22" r="11" fill="#78350F"/>
                                    <circle cx="18" cy="22" r="9.5" fill="url(#questBronzeGrad)"/>
                                    <circle cx="18" cy="22" r="7.8" stroke="#D97706" stroke-width="0.8" fill="none"/>
                                    <path d="M18 17.5L19.3 20.7L22.6 20.9L20 22.9L20.9 26.2L18 24.3L15.1 26.2L16 22.9L13.4 20.9L16.7 20.7L18 17.5Z" fill="#FFEDD5" stroke="#78350F" stroke-width="0.5"/>
                                    <defs>
                                        <linearGradient id="questBronzeGrad" x1="12" y1="13" x2="24" y2="31" gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#FDBA74"/>
                                            <stop offset="0.45" stop-color="#EA580C"/>
                                            <stop offset="1" stop-color="#9A3412"/>
                                        </linearGradient>
                                    </defs>
                                </svg>
                                {{/istop3}}
                                {{^istop}}<span class="quest-rank-number">{{rank}}</span>{{/istop}}
                            </td>
                            <td>
                                <div class="fw-bold fs-6 text-dark">
                                    <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>{{teamname}}
                                </div>
                            </td>
                            <td class="text-center">{{nanswers}}</td>
                            <td class="text-center text-muted">{{nanswerassessment}}</td>
                            {{#showauthoringdetails}}
                            <td class="text-center">{{nsubmissions}}</td>
                            <td class="text-center text-muted">{{nsubmissionsassessment}}</td>
                            <td class="text-center text-muted">{{pointssubmission}}</td>
                            <td class="text-center text-muted">{{pointsanswers}}</td>
                            {{/showauthoringdetails}}
                            <td class="text-end pe-4">
                                <span class="badge bg-success fs-6 py-1 px-3">{{points}} pts</span>
                            </td>
                        </tr>
                        {{/standings}}
                        {{^standings}}
                        <tr>
                            <td colspan="{{#showauthoringdetails}}9{{/showauthoringdetails}}{{^showauthoringdetails}}5{{/showauthoringdetails}}" class="text-center text-muted py-4">
                                {{#str}}nostudentsyet{{/str}}
                            </td>
                        </tr>
                        {{/standings}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/isteams}}

    {{^isteams}}
    <!-- Individual Standings Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;" class="text-center">

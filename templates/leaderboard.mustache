                                    <path d="M12 2L8.5 10.5L13 17L18 2H12Z" fill="#991B1B"/>
                                    <path d="M24 2L29 16L23 17L18 2H24Z" fill="#2563EB"/>
                                    <path d="M24 2L27.5 10.5L23 17L18 2H24Z" fill="#1D4ED8"/>
                                    <path d="M15 14L18 18L21 14H15Z" fill="#7F1D1D"/>
                                    <circle cx="18" cy="22" r="11" fill="#78350F"/>
                                    <circle cx="18" cy="22" r="9.5" fill="url(#questBronzeGrad)"/>

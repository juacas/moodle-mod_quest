                            </th>
                            <th scope="col">
                                <a href="{{{sort_user.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}user{{/str}}{{{sort_user.icon}}}</a>{{{help_user}}}
                            </th>
                            {{#allowteams}}
                            <th scope="col">

                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_pointssubmission.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}authorpoints, quest{{/str}}{{{sort_pointssubmission.icon}}}</a>{{{help_pointssubmission}}}
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{{sort_pointsanswers.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}answerpoints, quest{{/str}}{{{sort_pointsanswers.icon}}}</a>{{{help_pointsanswers}}}
                            </th>
                            <th scope="col" class="text-end pe-4">
                                <a href="{{{sort_points.url}}}" class="text-dark text-decoration-none fw-bold">{{#str}}totalpoints, quest{{/str}}{{{sort_points.icon}}}</a>{{{help_points}}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#standings}}
                        <tr class="{{#iscurrentuser}}table-primary fw-bold{{/iscurrentuser}}">
                            <td class="text-center">
                                {{#istop1}}

                                <span class="badge bg-success fs-6 py-1 px-3">{{points}} pts</span>
                            </td>
                        </tr>
                        {{/standings}}
                        {{^standings}}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                {{#str}}nostudentsyet{{/str}}
                            </td>
                        </tr>
                        {{/standings}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/isteams}}
</div>

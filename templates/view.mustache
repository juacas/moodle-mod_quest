{{!
    @template mod_quest/view

    Tournament dashboard view template with initial summary section and Card/List view toggle for challenges.
}}
<div class="mod-quest-dashboard mb-4">
    <!-- ========================================================= -->
    <!-- 1. RESUMEN DE DATOS EN LA PARTE INICIAL DE LA PÁGINA       -->
    <!-- ========================================================= -->

    <!-- Tournament Header Banner -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold mb-1">{{questname}}</h3>
                    <div class="text-muted small">
                        <i class="fa fa-calendar me-1" aria-hidden="true"></i> {{datestartstr}} &mdash; {{dateendstr}}
                        {{#allowteams}}
                        <span class="badge bg-secondary ms-2"><i class="fa fa-users me-1"></i>{{#str}}team, quest{{/str}}</span>
                        {{/allowteams}}
                    </div>
                </div>
                <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
                    {{#canaddchallenge}}
                    <a href="{{{addchallengeurl}}}" class="btn btn-primary shadow-sm">
                        <i class="fa fa-plus-circle me-1" aria-hidden="true"></i> {{#str}}addchallenge, quest{{/str}}
                    </a>
                    {{/canaddchallenge}}
                    <a href="{{{leaderboardurl}}}" class="btn btn-outline-primary">
                        <i class="fa fa-trophy me-1" aria-hidden="true"></i> {{#str}}clasification, quest{{/str}}
                    </a>
                    {{#myplaceurl}}
                    <a href="{{{myplaceurl}}}" class="btn btn-outline-secondary">
                        <i class="fa fa-user me-1" aria-hidden="true"></i> {{#str}}myplace, quest{{/str}}
                    </a>
                    {{/myplaceurl}}
                    {{#teamurl}}
                    <a href="{{{teamurl}}}" class="btn btn-outline-secondary">
                        <i class="fa fa-users me-1" aria-hidden="true"></i> {{#str}}changeteamteacher, quest{{/str}}
                    </a>
                    {{/teamurl}}
                </div>
            </div>

            <!-- Teacher Grading Actions Bar (if teacher) -->
            {{#hasgradinglinks}}
            <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center gap-3 small">
                <span class="fw-bold text-muted"><i class="fa fa-sliders me-1" aria-hidden="true"></i>{{#str}}grading, quest{{/str}}:</span>
                {{#challengegradinghtml}}{{{challengegradinghtml}}}{{/challengegradinghtml}}
                {{#answergradinghtml}}{{{answergradinghtml}}}{{/answergradinghtml}}
            </div>
            {{/hasgradinglinks}}
        </div>
    </div>

    <!-- Summary Details: Description & Leaderboard Overview -->
    <div class="row g-4 mb-4">
        <!-- Left: Description and Attachments -->
        <div class="col-lg-7">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fa fa-info-circle text-primary me-2" aria-hidden="true"></i>{{#str}}description, quest{{/str}}
                    </h5>
                </div>
                <div class="card-body">
                    {{#intro}}
                    <div class="quest-intro text-secondary">
                        {{{intro}}}
                    </div>
                    {{/intro}}
                    {{^intro}}
                    <p class="text-muted small mb-0">{{#str}}nodescription, quest{{/str}}</p>
                    {{/intro}}

                    {{#hasintroattachments}}
                    <div class="mt-3 pt-2 border-top">
                        {{{introattachments}}}
                    </div>
                    {{/hasintroattachments}}
                </div>
            </div>
        </div>

        <!-- Right: Leaderboard Overview -->
        <div class="col-lg-5">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fa fa-trophy text-warning me-2" aria-hidden="true"></i>{{#str}}clasification, quest{{/str}}
                    </h5>
                    {{#clasificationswitchurl}}
                    <a href="{{{clasificationswitchurl}}}" class="btn btn-sm btn-outline-secondary">
                        {{clasificationswitchlabel}}
                    </a>
                    {{/clasificationswitchurl}}
                </div>
                <div class="card-body">
                    {{#simplecalificationhtml}}
                    <div class="quest-simple-calification overflow-auto mb-3">
                        {{{simplecalificationhtml}}}
                    </div>
                    {{/simplecalificationhtml}}
                    <div class="text-center pt-2 border-top">
                        <a href="{{{leaderboardurl}}}" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-bar-chart me-1" aria-hidden="true"></i> {{#str}}viewclasification, quest{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. SECCIÓN DE DESAFÍOS (Vistas Cards / List agrupadas)     -->
    <!-- ========================================================= -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <!-- Section Header with View Selector -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0">
                        <i class="fa fa-flag-checkered text-warning me-2" aria-hidden="true"></i>{{#str}}challenges, quest{{/str}}
                    </h4>
                    <span class="badge bg-dark rounded-pill">{{challengecount}}</span>
                </div>

                <!-- View Switcher Controls (Card / List) -->
                <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}view, moodle{{/str}}">
                    <button type="button" class="btn btn-primary active quest-view-toggle-btn" id="quest-toggle-cards-btn" data-view="cards" title="{{#str}}cardview, quest{{/str}}">
                        <i class="fa fa-th-large me-1" aria-hidden="true"></i> {{#str}}cards, quest{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-primary quest-view-toggle-btn" id="quest-toggle-list-btn" data-view="list" title="{{#str}}listview, quest{{/str}}">
                        <i class="fa fa-list me-1" aria-hidden="true"></i> {{#str}}list, quest{{/str}}
                    </button>
                </div>
            </div>

            <!-- VISTA 1: CARDS -->
            <div id="quest-challenges-cards-view">
                {{#haschallenges}}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    {{#challenges}}
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm quest-challenge-card position-relative" style="cursor: pointer;" onclick="window.location.href='{{{viewurl}}}';">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge {{phaseclass}}">{{phasename}}</span>
                                    <span class="badge bg-success fs-7">{{currentpoints}} pts</span>
                                </div>

                                <h5 class="card-title fw-bold mb-2">
                                    <a href="{{{viewurl}}}" class="text-decoration-none text-dark stretched-link">{{title}}</a>
                                </h5>

                                <p class="card-text text-muted small flex-grow-1 mb-2">
                                    {{descriptionexcerpt}}
                                </p>

                                {{#minichartsvg}}
                                <div class="quest-card-chart-wrapper my-2" title="{{#str}}questgraphtitle, quest{{/str}}">
                                    {{{minichartsvg}}}
                                </div>
                                {{/minichartsvg}}

                                <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top text-muted small">
                                    <span><i class="fa fa-comments-o me-1"></i>{{nanswers}} {{#str}}answers, quest{{/str}}</span>
                                    <span><i class="fa fa-clock-o me-1"></i>{{timeleft}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/challenges}}
                </div>
                {{/haschallenges}}

                {{^haschallenges}}
                <div class="card border-0 shadow-sm text-center p-5">
                    <div class="card-body">
                        <i class="fa fa-lightbulb-o fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <h5 class="text-muted">{{#str}}nochallengestoshow, quest{{/str}}</h5>
                        {{#canaddchallenge}}
                        <a href="{{{addchallengeurl}}}" class="btn btn-primary mt-2">
                            <i class="fa fa-plus me-1"></i> {{#str}}addchallenge, quest{{/str}}
                        </a>
                        {{/canaddchallenge}}
                    </div>
                </div>
                {{/haschallenges}}
            </div>

            <!-- VISTA 2: LIST / DETAILED TABLE -->
            <div id="quest-challenges-list-view" style="display: none;">
                {{#hasdetailtable}}
                <div class="table-responsive">
                    {{{detailtablehtml}}}
                </div>
                {{#legendhtml}}
                <div class="text-muted small text-center mt-3">
                    {{{legendhtml}}}
                </div>
                {{/legendhtml}}
                {{/hasdetailtable}}

                {{^hasdetailtable}}
                <div class="text-center p-5 text-muted">
                    <i class="fa fa-inbox fa-3x text-muted mb-3" aria-hidden="true"></i>
                    <h5>{{#str}}nochallengestoshow, quest{{/str}}</h5>
                </div>
                {{/hasdetailtable}}
            </div>
        </div>
    </div>
</div>

{{#js}}
(function() {
    var cardsBtn = document.getElementById('quest-toggle-cards-btn');
    var listBtn = document.getElementById('quest-toggle-list-btn');
    var cardsView = document.getElementById('quest-challenges-cards-view');
    var listView = document.getElementById('quest-challenges-list-view');

    if (!cardsBtn || !listBtn || !cardsView || !listView) {
        return;
    }

    function setView(mode) {
        if (mode === 'list') {
            cardsView.style.display = 'none';
            listView.style.display = 'block';
            cardsBtn.classList.remove('active', 'btn-primary');
            cardsBtn.classList.add('btn-outline-primary');
            listBtn.classList.add('active', 'btn-primary');
            listBtn.classList.remove('btn-outline-primary');
        } else {
            cardsView.style.display = 'block';
            listView.style.display = 'none';
            cardsBtn.classList.add('active', 'btn-primary');
            cardsBtn.classList.remove('btn-outline-primary');
            listBtn.classList.remove('active', 'btn-primary');
            listBtn.classList.add('btn-outline-primary');
        }
        try {
            localStorage.setItem('quest_challenges_view_mode', mode);
        } catch (e) {}
    }

    cardsBtn.addEventListener('click', function(e) {
        e.preventDefault();
        setView('cards');
    });

    listBtn.addEventListener('click', function(e) {
        e.preventDefault();
        setView('list');
    });

    var urlParams = new URLSearchParams(window.location.search);
    var hasSort = urlParams.has('sort') || urlParams.has('dir') || urlParams.get('view') === 'list';
    var savedMode = '';
    try {
        savedMode = localStorage.getItem('quest_challenges_view_mode');
    } catch (e) {}

    if (hasSort || savedMode === 'list') {
        setView('list');
    } else {
        setView('cards');
    }
})();
{{/js}}

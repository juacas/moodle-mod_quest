{{!
    @template mod_quest/view

    Tournament dashboard view template with initial summary section and Card/List view toggle for challenges.
}}
<div class="mod-quest-dashboard mb-4">
    <!-- ========================================================= -->
    <!-- 2. LAYOUT DE DOS BLOQUES: RESUMEN Y RANKING               -->
    <!-- ========================================================= -->
    <div class="row g-4 mb-4">
        <!-- Bloque Izquierdo: Resumen de la actividad -->
        <div class="col-lg-7 col-md-12">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fa fa-info-circle text-primary me-2" aria-hidden="true"></i>{{#str}}summary, moodle{{/str}}
                    </h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between p-4 pt-0">
                    <div>
                        <!-- Fechas: Inicio y Final, y modo Teams -->
                        <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                            <span class="badge bg-light text-dark border py-2 px-3">
                                <i class="fa fa-calendar-check-o text-success me-1" aria-hidden="true"></i>
                                <strong>{{#str}}datestart, quest{{/str}}:</strong> {{datestartstr}}
                            </span>
                            <span class="badge bg-light text-dark border py-2 px-3">
                                <i class="fa fa-calendar-times-o text-danger me-1" aria-hidden="true"></i>
                                <strong>{{#str}}dateend, quest{{/str}}:</strong> {{dateendstr}}
                            </span>
                            {{#scheduleurl}}
                            <a href="{{{scheduleurl}}}" class="btn btn-outline-info">
                                <i class="fa fa-calendar me-1" aria-hidden="true"></i> {{#str}}reorderchallenges, quest{{/str}}
                            </a>
                            {{/scheduleurl}}
                        </div>
                        <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                            {{#allowteams}}
                            <span class="badge bg-light text-dark border py-2 px-3">
                                <i class="fa fa-users me-1" aria-hidden="true"></i>
                                <strong>{{#str}}mode, quest{{/str}}:</strong> {{#str}}team, quest{{/str}}
                            </span>
                            {{/allowteams}}
                            {{#teamurl}}
                            <a href="{{{teamurl}}}" class="btn btn-outline-secondary">
                                <i class="fa fa-users me-1" aria-hidden="true"></i> {{#str}}changeteamteacher, quest{{/str}}
                            </a>
                            {{/teamurl}}
                        </div>

                        <!-- Información de Grading -->
                        {{#hasgradinglinks}}
                        <div class="p-3 mb-3 bg-light rounded border">
                            <div class="fw-bold text-secondary mb-2 small text-uppercase">
                                <i class="fa fa-sliders me-1" aria-hidden="true"></i>{{#str}}grading, quest{{/str}}
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                {{#challengegradinghtml}}{{{challengegradinghtml}}}{{/challengegradinghtml}}
                                {{#answergradinghtml}}{{{answergradinghtml}}}{{/answergradinghtml}}
                            </div>
                        </div>
                        {{/hasgradinglinks}}
                    </div>

                    <!-- Todos los botones de acción -->
                    <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2">
                        {{#canaddchallenge}}
                        <a href="{{{addchallengeurl}}}" class="btn btn-primary shadow-sm">
                            <i class="fa fa-plus-circle me-1" aria-hidden="true"></i> {{#str}}addchallenge, quest{{/str}}
                        </a>
                        {{#canaddqchallenge}}
                        <a href="{{{addqchallengeurl}}}" class="btn btn-outline-primary shadow-sm">
                            <i class="fa fa-question-circle me-1" aria-hidden="true"></i> {{#str}}addquestionchallenge, quest{{/str}}
                        </a>
                        {{/canaddqchallenge}}
                        {{/canaddchallenge}}
                        <a href="{{{leaderboardurl}}}" class="btn btn-outline-primary">
                            <i class="fa fa-trophy me-1" aria-hidden="true"></i> {{#str}}clasification, quest{{/str}}
                        </a>
                        {{#myplaceurl}}
                        <a href="{{{myplaceurl}}}" class="btn btn-outline-secondary">
                            <i class="fa fa-user me-1" aria-hidden="true"></i> {{#str}}myplace, quest{{/str}}
                        </a>
                        {{/myplaceurl}}


                    </div>
                </div>
            </div>
        </div>

        <!-- Bloque Derecho: Ranking (con flow responsive) -->
        <div class="col-lg-5 col-md-12">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="fa fa-trophy text-warning me-2" aria-hidden="true"></i>{{#str}}clasification, quest{{/str}}
                    </h5>
                    {{#clasificationswitchurl}}
                    <a href="{{{clasificationswitchurl}}}" class="btn btn-sm btn-outline-secondary">
                        {{clasificationswitchlabel}}
                    </a>
                    {{/clasificationswitchurl}}
                </div>
                <div class="card-body d-flex flex-column justify-content-between p-4 pt-0">
                    {{#simplecalificationhtml}}
                    <div class="quest-simple-calification overflow-auto mb-3">
                        {{{simplecalificationhtml}}}
                    </div>
                    {{/simplecalificationhtml}}
                    <div class="text-center pt-2 border-top">
                        <a href="{{{leaderboardurl}}}" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-bar-chart me-1" aria-hidden="true"></i> {{#str}}viewclasification, quest{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. SECCIÓN DE DESAFÍOS (Vistas Cards / List agrupadas)     -->
    <!-- ========================================================= -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <!-- Section Header with View Selector -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0">
                        <i class="fa fa-flag-checkered text-warning me-2" aria-hidden="true"></i>{{#str}}challenges, quest{{/str}}
                    </h4>
                    <span class="badge bg-dark rounded-pill">{{challengecount}}</span>
                </div>

                <!-- View Switcher Controls (Card / List) -->
                <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}view, moodle{{/str}}">
                    <button type="button" class="btn btn-primary active quest-view-toggle-btn" id="quest-toggle-cards-btn" data-view="cards" title="{{#str}}cardview, quest{{/str}}">
                        <i class="fa fa-th-large me-1" aria-hidden="true"></i> {{#str}}cards, quest{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-primary quest-view-toggle-btn" id="quest-toggle-list-btn" data-view="list" title="{{#str}}listview, quest{{/str}}">
                        <i class="fa fa-list me-1" aria-hidden="true"></i> {{#str}}list, quest{{/str}}
                    </button>
                </div>
            </div>

            <!-- VISTA 1: CARDS -->
            <div id="quest-challenges-cards-view">
                {{#haschallenges}}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    {{#challenges}}
                    <div class="col">
                        {{! ── Challenge card: reformed layout ─────────────────────────────────── }}
                        <div class="card shadow-sm quest-challenge-card h-100" style="min-height:320px; cursor:pointer; {{{cardstyle}}}" onclick="window.location.href='{{{viewurl}}}'">
                            <div class="card-body d-flex flex-column p-3" style="position:relative; overflow:hidden;">

                                {{! ── SCORE + CHART: absolutely pinned top-right, fixed 96px wide ── }}
                                {{#minichartsvg}}
                                <div style="position:absolute; top:0.75rem; right:0.75rem; width:96px; display:flex; flex-direction:column; align-items:flex-end; z-index:1; pointer-events:none;">
                                    <span class="badge bg-success mb-1" style="font-size:0.75rem; white-space:nowrap;">
                                        <span class="quest-score-counter"
                                            data-datestart="{{datestart}}" data-dateend="{{dateend}}"
                                            data-tinitial="{{tinitial}}" data-dateanswercorrect="{{dateanswercorrect}}"
                                            data-initialpoints="{{initialpoints}}" data-pointsmax="{{pointsmax}}"
                                            data-pointsmin="{{pointsmin}}" data-type="{{type}}">{{currentpoints}}</span> pts
                                    </span>
                                    <div class="quest-card-chart-full" style="width:96px; height:96px; overflow:hidden;" title="{{#str}}questgraphtitle, quest{{/str}}">
                                        {{{minichartsvg}}}
                                    </div>
                                </div>
                                {{/minichartsvg}}
                                {{^minichartsvg}}
                                <div style="position:absolute; top:0.75rem; right:0.75rem; z-index:1; pointer-events:none;">
                                    <span class="badge bg-success" style="font-size:0.75rem; white-space:nowrap;">
                                        <span class="quest-score-counter"
                                            data-datestart="{{datestart}}" data-dateend="{{dateend}}"
                                            data-tinitial="{{tinitial}}" data-dateanswercorrect="{{dateanswercorrect}}"
                                            data-initialpoints="{{initialpoints}}" data-pointsmax="{{pointsmax}}"
                                            data-pointsmin="{{pointsmin}}" data-type="{{type}}">{{currentpoints}}</span> pts
                                    </span>
                                </div>
                                {{/minichartsvg}}

                                {{! ── HEADER: badge + title. Right padding reserves space for the pinned score col ── }}
                                <div class="flex-shrink-0 mb-2" style="padding-right:108px;">
                                    {{#attentionstatuses}}
                                    <a href="{{{url}}}"
                                       class="{{class}}"
                                       title="{{label}}"
                                       onclick="event.stopPropagation();">
                                        <i class="{{icon}}" aria-hidden="true"></i>
                                        {{label}}
                                    </a>
                                    {{/attentionstatuses}}
                                    <span class="badge {{phaseclass}} mb-1">{{phasename}}</span>
                                    <h5 class="card-title fw-bold mb-0 lh-sm" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" title="{{title}}">
                                        <a href="{{{viewurl}}}" class="text-decoration-none text-dark stretched-link">{{title}}</a>
                                    </h5>
                                </div>

                                {{! ── DESCRIPTION: grows to fill available space ── }}
                                <div class="card-text text-secondary small flex-grow-1 quest-challenge-description pe-1"
                                     style="max-height:160px; overflow:hidden;">
                                    {{{description}}}
                                </div>

                                {{! ── FOOTER stats ── }}
                                <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top text-muted small flex-shrink-0">
                                    <span><i class="fa fa-comments-o me-1"></i>{{nanswers}} {{#str}}answers, quest{{/str}}</span>
                                    <span><i class="fa fa-clock-o me-1"></i>{{timeleft}}</span>
                                </div>

                            </div>
                        </div>
                    </div>

                    {{/challenges}}
                </div>
                {{/haschallenges}}
                {{^haschallenges}}
                <div class="alert alert-info text-center my-3" role="alert">
                    <i class="fa fa-info-circle me-1" aria-hidden="true"></i> {{#str}}nochallenges, quest{{/str}}
                </div>
                {{/haschallenges}}
            </div>

            <!-- VISTA 2: LIST (Tabla de detalles) -->
            <div id="quest-challenges-list-view" style="display: none;">
                {{#caneditdates}}
                <div id="quest-view-date-actions" class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span id="quest-view-date-dirty-badge" class="badge bg-warning text-dark d-none">
                        <i class="fa fa-pencil me-1" aria-hidden="true"></i>
                        {{#str}}unsavedchanges, quest{{/str}}
                    </span>
                    <span id="quest-view-date-status-msg" class="text-muted small"></span>
                    <button type="button" class="btn btn-success btn-sm px-3" id="quest-view-date-save-btn" disabled>
                        <i class="fa fa-check me-1" aria-hidden="true"></i>
                        {{#str}}savechanges, moodle{{/str}}
                    </button>
                </div>
                {{/caneditdates}}
                {{#hasdetailtable}}
                <div class="table-responsive">
                    {{{detailtablehtml}}}
                </div>
                {{#legendhtml}}
                <div class="mt-3">
                    {{{legendhtml}}}
                </div>
                {{/legendhtml}}
                {{/hasdetailtable}}
                {{^hasdetailtable}}
                <div class="alert alert-info text-center my-3" role="alert">
                    <i class="fa fa-info-circle me-1" aria-hidden="true"></i> {{#str}}nochallenges, quest{{/str}}
                </div>
                {{/hasdetailtable}}
            </div>
        </div>
    </div>
</div>

{{#caneditdates}}
<div class="modal fade" id="quest-view-date-modal" tabindex="-1" aria-labelledby="questViewDateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-light border-bottom">
                <h5 class="modal-title fw-bold text-dark" id="questViewDateModalLabel">
                    <i class="fa fa-calendar-check-o text-primary me-2" aria-hidden="true"></i>
                    {{#str}}editdatesmodal, quest{{/str}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, moodle{{/str}}"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quest-view-date-modal-cid" value="">
                <div class="alert alert-danger d-none py-2 px-3 mb-3 small" id="quest-view-date-modal-error">
                    <i class="fa fa-exclamation-circle me-1" aria-hidden="true"></i>
                    <span>{{#str}}invaliddateorder, quest{{/str}}</span>
                </div>
                <div class="mb-3">
                    <label for="quest-view-date-modal-start" class="form-label fw-bold small text-secondary">
                        <i class="fa fa-play text-success me-1" aria-hidden="true"></i>
                        {{#str}}datestart, quest{{/str}}
                    </label>
                    <input type="datetime-local" class="form-control" id="quest-view-date-modal-start" required>
                </div>
                <div class="mb-3">
                    <label for="quest-view-date-modal-end" class="form-label fw-bold small text-secondary">
                        <i class="fa fa-stop text-danger me-1" aria-hidden="true"></i>
                        {{#str}}dateend, quest{{/str}}
                    </label>
                    <input type="datetime-local" class="form-control" id="quest-view-date-modal-end" required>
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-secondary btn-sm" id="quest-view-date-modal-cancel" data-bs-dismiss="modal">{{#str}}cancel, moodle{{/str}}</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="quest-view-date-modal-apply">
                    <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}apply, moodle{{/str}}
                </button>
            </div>
        </div>
    </div>
</div>
{{/caneditdates}}

{{#js}}
require(['mod_quest/counter'], function(counter) {
    counter.init({{servertime}});
});

(function() {
    var cardsBtn = document.getElementById('quest-toggle-cards-btn');
    var listBtn = document.getElementById('quest-toggle-list-btn');
    var cardsView = document.getElementById('quest-challenges-cards-view');
    var listView = document.getElementById('quest-challenges-list-view');

    if (!cardsBtn || !listBtn || !cardsView || !listView) {
        return;
    }

    function setView(mode) {
        if (mode === 'list') {
            cardsView.style.display = 'none';
            listView.style.display = 'block';
            cardsBtn.classList.remove('active', 'btn-primary');
            cardsBtn.classList.add('btn-outline-primary');
            listBtn.classList.add('active', 'btn-primary');
            listBtn.classList.remove('btn-outline-primary');
        } else {
            cardsView.style.display = 'block';
            listView.style.display = 'none';
            cardsBtn.classList.add('active', 'btn-primary');
            cardsBtn.classList.remove('btn-outline-primary');
            listBtn.classList.remove('active', 'btn-primary');
            listBtn.classList.add('btn-outline-primary');
        }
        try {
            localStorage.setItem('quest_challenges_view_mode', mode);
        } catch (e) {}
    }

    cardsBtn.addEventListener('click', function(e) {
        e.preventDefault();
        setView('cards');
    });

    listBtn.addEventListener('click', function(e) {
        e.preventDefault();
        setView('list');
    });

    var savedMode = '';
    try {
        savedMode = localStorage.getItem('quest_challenges_view_mode');
    } catch (e) {}

    if (savedMode === 'list' || savedMode === 'cards') {
        setView(savedMode);
    } else {
        var urlParams = new URLSearchParams(window.location.search);
        var requestedMode = urlParams.get('view');
        if (requestedMode === 'cards' || requestedMode === 'list') {
            setView(requestedMode);
        } else {
            setView('list');
        }
    }
})();
{{/js}}
